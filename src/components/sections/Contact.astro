---
---

<section id="contact" class="contact section">
  <div class="container">
    <div class="section-header">
      <span class="section-tag">Get In Touch</span>
      <h2 class="section-title">Let's Build Something <span class="text-gradient">Extraordinary</span></h2>
      <p class="section-subtitle">
        Whether you have a full-stack project, an internship opportunity, or just want to connect—reach out!
      </p>
    </div>

    <div class="contact-grid">
      <!-- Contact Details Card -->
      <div class="contact-info glass-card">
        <h3 class="info-title">Contact Information</h3>
        <p class="info-desc">
          Feel free to reach out via email, phone, or connect with me on LinkedIn and GitHub. I'm always open to discussing enterprise web architectures and exciting opportunities.
        </p>

        <div class="info-items">
          <div class="info-item">
            <div class="icon-box">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
            </div>
            <div>
              <span class="label">Phone / WhatsApp</span>
              <p class="value code-font"><a href="tel:+919883327593">+91 9883327593</a></p>
            </div>
          </div>

          <div class="info-item">
            <div class="icon-box">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"></rect><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path></svg>
            </div>
            <div>
              <span class="label">Email Address</span>
              <p class="value code-font"><a href="mailto:ayanpathak81@gmail.com">ayanpathak81@gmail.com</a></p>
            </div>
          </div>

          <div class="info-item">
            <div class="icon-box">
              <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
            </div>
            <div>
              <span class="label">Location</span>
              <p class="value">Purba Bardhaman, West Bengal, India</p>
            </div>
          </div>
        </div>

        <div class="availability-card">
          <span class="status-dot"></span>
          <span class="avail-text">Currently seeking software engineering internships & full-time roles.</span>
        </div>

        <!-- Interactive Map View -->
        <div class="map-wrapper">
          <div class="map-header">
            <span class="map-title font-semibold flex items-center gap-2">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-accent"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              Purba Bardhaman, West Bengal
            </span>
            <span class="map-badge code-font">Open for Remote / Relocation</span>
          </div>
          <div class="map-frame-container">
            <iframe 
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d234555.20177726354!2d87.75336113115456!3d23.250551350438186!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x39f83822c92e947d%3A0xc078e8aa019a897b!2sPurba%20Bardhaman%2C%20West%20Bengal!5e0!3m2!1sen!2sin!4v1700000000000!5m2!1sen!2sin" 
              width="100%" 
              height="200" 
              style="border:0;" 
              allowfullscreen="" 
              loading="lazy" 
              referrerpolicy="no-referrer-when-downgrade"
              title="Purba Bardhaman Map Location"
              class="map-iframe"
            ></iframe>
          </div>
        </div>
      </div>

      <!-- Interactive Contact Form -->
      <div class="contact-form-wrapper glass-card">
        <form id="contact-form" class="contact-form" onsubmit="return false;">
          <h3 class="form-title">Send a Message</h3>

          <!-- Web3Forms hidden fields -->
          <input type="hidden" name="access_key" value="65668d12-dc2e-457d-8689-6c7c62c66e4d" />
          <input type="hidden" name="subject" value="New Portfolio Contact — Ayan Kumar Pathak" />
          <input type="hidden" name="from_name" value="Portfolio Contact Form" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

          <div class="form-row">
            <div class="form-group">
              <label for="name">Your Name</label>
              <input type="text" id="name" name="name" required placeholder="e.g. John Doe" />
            </div>
            <div class="form-group">
              <label for="email">Email Address</label>
              <input type="email" id="email" name="email" required placeholder="john@example.com" />
            </div>
          </div>

          <div class="form-group">
            <label for="message">Your Message</label>
            <textarea id="message" name="message" rows="5" required placeholder="Tell me about your project or role..."></textarea>
          </div>

          <button type="submit" class="btn btn-primary submit-btn">
            <span>Send Message</span>
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"></path></svg>
          </button>
        </form>

        <!-- Toast Feedback -->
        <div id="form-toast" class="toast-notification hide">
          <span class="toast-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color: #10b981;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
          </span>
          <div class="toast-msg">
            <strong>Message Sent Successfully!</strong>
            <p>Thank you for reaching out. Ayan Kumar Pathak will get back to you shortly.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 3rem;
    align-items: start;
  }

  .contact-info, .contact-form-wrapper {
    padding: 2.5rem;
  }

  .info-title, .form-title {
    font-size: 1.75rem;
    color: var(--text-primary);
    margin-bottom: 1rem;
  }

  .info-desc {
    color: var(--text-secondary);
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .info-items {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    margin-bottom: 2.5rem;
  }

  .info-item {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .icon-box {
    width: 50px;
    height: 50px;
    border-radius: var(--radius-md);
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
  }

  .label {
    font-size: 0.85rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .value {
    font-size: 1.1rem;
    color: var(--text-primary);
    font-weight: 600;
  }

  .value a:hover {
    color: var(--text-accent);
  }

  .availability-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-radius: var(--radius-md);
    background: var(--status-glow);
    border: 1px solid var(--status-active);
    color: var(--text-primary);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .status-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--status-active);
    box-shadow: 0 0 10px var(--status-active);
    animation: pulse-glow 2s infinite;
  }

  /* Map View Styling */
  .map-wrapper {
    margin-top: 2rem;
    border-radius: var(--radius-md);
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .map-wrapper:hover {
    border-color: var(--accent-primary);
    box-shadow: 0 5px 20px -5px var(--accent-glow);
  }

  .map-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.85rem 1.25rem;
    border-bottom: 1px solid var(--border-color);
    background: var(--bg-card);
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .map-title {
    color: var(--text-primary);
    font-size: 0.95rem;
  }

  .map-badge {
    font-size: 0.75rem;
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
    background: var(--status-glow);
    color: var(--status-active);
    border: 1px solid var(--status-active);
  }

  .map-frame-container {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .map-iframe {
    width: 100%;
    height: 100%;
    display: block;
    filter: contrast(95%);
  }

  /* Form Styles */
  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .form-group input, .form-group textarea {
    width: 100%;
    padding: 0.85rem 1.2rem;
    border-radius: var(--radius-sm);
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    font-family: inherit;
    font-size: 1rem;
    transition: all 0.25s ease;
  }

  .form-group input:focus, .form-group textarea:focus {
    outline: none;
    border-color: var(--accent-primary);
    box-shadow: 0 0 10px -2px var(--accent-glow);
  }

  .submit-btn {
    align-self: flex-start;
    margin-top: 0.5rem;
    cursor: pointer;
  }

  /* Toast Notification */
  .toast-notification {
    margin-top: 1.5rem;
    padding: 1.25rem;
    border-radius: var(--radius-md);
    background: var(--status-glow);
    border: 1px solid var(--status-active);
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    transition: all 0.4s ease;
  }

  .toast-notification.hide {
    display: none;
  }

  .toast-icon {
    font-size: 1.5rem;
  }

  .toast-msg strong {
    color: var(--text-primary);
    display: block;
    margin-bottom: 0.25rem;
  }

  .toast-msg p {
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  @media (max-width: 968px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .form-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const toast = document.getElementById('form-toast');

  if (form && toast) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const submitBtn = form.querySelector('.submit-btn') as HTMLButtonElement | null;
      if (!submitBtn) return;

      const originalHTML = submitBtn.innerHTML;
      submitBtn.innerHTML = `<span>Sending...</span>`;
      submitBtn.disabled = true;

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());

      try {
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await response.json();

        if (result.success) {
          form.reset();
          toast.classList.remove('hide');
          toast.animate(
            [{ opacity: 0, transform: 'translateY(10px)' }, { opacity: 1, transform: 'translateY(0)' }],
            { duration: 400, easing: 'ease-out' }
          );
          setTimeout(() => toast.classList.add('hide'), 6000);
        } else {
          alert('Something went wrong. Please try again or email directly at ayanpathak81@gmail.com');
        }
      } catch (err) {
        alert('Network error. Please try again or email directly at ayanpathak81@gmail.com');
      } finally {
        submitBtn.innerHTML = originalHTML;
        submitBtn.disabled = false;
      }
    });
  }
</script>
